{
  "name": "netflix-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "typecheck": "tsc --noEmit",
