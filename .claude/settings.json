{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Edit(/data/catalog.db)",
      "Edit(/e2e/**)",
      "Edit(/playwright.config.ts)",
      "Edit(/tests/architecture/**)",
      "Edit(/scripts/verify.mjs)",
      "Edit(/curso/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/harness/**)",
      "Edit(/tests/harness/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/data/app.db)",
      "Read(/data/app.db)",
      "Bash(*app.db*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/stop.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
